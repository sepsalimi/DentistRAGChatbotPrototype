# Environment variables used by the local Dental Evidence Chat demo.
# Copy this file to .env and provide an OpenAI key to enable live RAG.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DENTAL_RAG_MODE=offline
NEXT_PUBLIC_API_URL=http://localhost:8000
