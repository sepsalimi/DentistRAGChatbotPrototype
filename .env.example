# Environment variables used by the working local Dental Evidence Chat stack.
# Offline lexical retrieval works without a key; vector mode requires OpenAI.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DENTAL_RAG_MODE=offline
# DENTAL_DATA_DIR=/absolute/path/to/persistent/data
NEXT_PUBLIC_API_URL=http://localhost:8000
